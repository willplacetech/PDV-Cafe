# Example env — copy to .env and fill values. Never commit secrets.

# MongoDB
MONGO_URI=mongodb://localhost:27017/pdv
MONGODB_URI=mongodb://localhost:27017/pdv

# JWT
JWT_SECRET=change-this-to-a-long-random-secret-string

# Autorização de gerente (default: true)
EXIGIR_AUTORIZACAO_GERENTE=true

# Sentry (opcional)
SENTRY_DSN=
APP_VERSION=

# Frontend API
VITE_API_URL=https://your-backend.onrender.com/api
VITE_SENTRY_DSN=
VITE_EXIGIR_AUTORIZACAO_GERENTE=true

# White-label (front-end build)
VITE_APP_NAME=PDV
VITE_APP_SHORT_NAME=PDV
VITE_APP_TAGLINE=Sistema de atendimento
VITE_APP_LOGO_URL=/logo.svg
VITE_APP_THEME_COLOR=#4f9d6a
VITE_APP_BG_COLOR=#f3f6f1
