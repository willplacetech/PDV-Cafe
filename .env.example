# Example env — copy to .env and fill values. Never commit secrets.

# MongoDB
MONGODB_URI=mongodb://localhost:27017/sabor-de-abraço-pdv

# JWT
JWT_SECRET=change-this-to-a-long-random-secret-string

# Autorização de gerente
# exigir senha de gerente para ações críticas (default: true)
EXIGIR_AUTORIZACAO_GERENTE=true

# Sentry (opcional — preencha com seu DSN para ativar rastreamento de erros)
SENTRY_DSN=

# Frontend
VITE_API_URL=https://your-backend.onrender.com/api
VITE_EXIGIR_AUTORIZACAO_GERENTE=true
