# Conexão e autenticação. Preencha somente no ambiente, nunca no Git.
MONGO_URI=
# Opcional: sem JWT_SECRET, uma chave aleatória de 48 bytes é persistida no MongoDB.
# Se definida, use uma chave aleatória com pelo menos 32 bytes UTF-8. Chaves fracas impedem a inicialização.
JWT_SECRET=
# Necessário apenas para criar o primeiro administrador (12 caracteres ou mais, até 72 bytes UTF-8).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# Origens próprias adicionais, separadas por vírgula.
FRONTEND_URL=http://localhost:5173

# DeliveryLink: criação do primeiro administrador da plataforma; mesma política de senha acima.
DELIVERY_ADMIN_EMAIL=
DELIVERY_ADMIN_PASSWORD=
# URL pública do frontend, usada nos links de rastreamento (sem barra final).
DELIVERY_PUBLIC_URL=http://localhost:5173
# Opcional: URL /messages da API oficial WhatsApp Cloud, com versão e phone-number-id.
WHATSAPP_API_URL=
WHATSAPP_ACCESS_TOKEN=

# NFC-e / SEFAZ. Nunca versionar certificado ou senha reais.
FISCAL_AMBIENTE=homologacao
NFCE_SERIE=1
NFCE_PROVIDER_URL=https://seu-provedor-fiscal.example/nfce
NFCE_PROVIDER_TOKEN=
NFCE_CNPJ=
NFCE_IE=
NFCE_RAZAO_SOCIAL=
NFCE_ENDERECO_LOGRADOURO=
NFCE_ENDERECO_NUMERO=
NFCE_ENDERECO_BAIRRO=
NFCE_ENDERECO_MUNICIPIO=
NFCE_ENDERECO_UF=SP
NFCE_ENDERECO_CEP=
NFCE_CERTIFICATE_PFX_BASE64=
NFCE_CERTIFICATE_PASSWORD=
# Opcional para alertar antes do vencimento.
NFCE_CERTIFICATE_EXPIRES_AT=
