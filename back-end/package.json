{
  "name": "pdv-server",
  "version": "1.0.0",
  "description": "Backend PDV - Express/MongoDB",
  "main": "server.js",
  "scripts": {
    "corrigir-bolos-gramas": "node scripts/corrigir-bolos-gramas.js",
    "normalizar-unidades": "node scripts/normalizar-unidades.js",
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "npm run test:unit && npm run test:integration",
    "test:watch": "cross-env NODE_ENV=test jest --watch",
    "test:coverage": "cross-env NODE_ENV=test jest --coverage --runInBand",
    "test:unit": "node --test test/*.test.js",
    "test:integration": "cross-env NODE_ENV=test jest --verbose --runInBand"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "bcryptjs": "^2.4.3",
    "colors": "^1.4.0",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "express": "^4.22.2",
    "express-rate-limit": "^8.6.2",
    "express-validator": "^7.3.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongodb": "^7.5.0",
    "mongoose": "^8.24.3",
    "morgan": "^1.11.0"
  },
  "devDependencies": {
    "cross-env": "^10.1.0",
    "jest": "^30.5.2",
    "mongodb-memory-server": "^11.2.0",
    "supertest": "^7.2.2"
  }
}
