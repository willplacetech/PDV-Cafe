{"name":"WillPlacetech","settings":"{\"settings\":\"{\\n  \\\"terminal.integrated.shellArgs.linux\\\": [\\\"/K\\\", \\\"chcp 1252\\\"],\\n  \\\"terminal.integrated.shellIntegration.enabled\\\": true,\\n  \\\"workbench.colorTheme\\\": \\\"Noctis Obscuro\\\",\\n  \\\"tabnine.experimentalAutoImports\\\": true,\\n  \\\"workbench.iconTheme\\\": \\\"vscode-icons\\\",\\n  \\\"cSpell.enabled\\\": false,\\n  \\\"javascript.updateImportsOnFileMove.enabled\\\": \\\"always\\\",\\n  \\\"[css]\\\": {\\n    \\\"editor.defaultFormatter\\\": \\\"vscode.css-language-features\\\",\\n  },\\n  \\\"[javascriptreact]\\\": {\\n    \\\"editor.defaultFormatter\\\": \\\"rvest.vs-code-prettier-eslint\\\",\\n  },\\n  \\\"vsicons.dontShowNewVersionMessage\\\": true,\\n  \\\"cSpell.languageSettings\\\": [],\\n  \\\"vscode-edge-devtools.webhint\\\": false,\\n  \\\"git.enableSmartCommit\\\": true,\\n  \\\"git.autofetch\\\": true,\\n  \\\"git.confirmSync\\\": false,\\n  \\\"python.analysis.typeCheckingMode\\\": \\\"standard\\\",\\n  \\\"githubPullRequests.pullBranch\\\": \\\"never\\\",\\n  \\\"claudeCode.preferredLocation\\\": \\\"panel\\\",\\n  \\\"githubPullRequests.createOnPublishBranch\\\": \\\"never\\\",\\n  \\\"chat.tools.terminal.autoApprove\\\": {\\n    \\\"/^git ls-tree -r --name-only origin/backend \\\\\\\\| Select-String -NotMatch 'node_modules\\\\\\\\|package-lock'$/\\\": {\\n      \\\"approve\\\": true,\\n      \\\"matchCommandLine\\\": true,\\n    },\\n  },\\n  \\\"github.copilot.enable\\\": {\\n    \\\"python\\\": true,\\n    \\\"dotenv\\\": true,\\n    \\\"javascript\\\": true,\\n    \\\"yaml\\\": true,\\n    \\\"plaintext\\\": true,\\n  },\\n  \\\"chat.tools.urls.autoApprove\\\": {\\n    \\\"https://code.visualstudio.com\\\": true,\\n    \\\"https://github.com/microsoft/vscode/wiki/*\\\": true,\\n    \\\"https://sistemaagendamentos.onrender.com\\\": {\\n      \\\"approveRequest\\\": true,\\n      \\\"approveResponse\\\": false,\\n    },\\n    \\\"https://meucaminhoback.onrender.com\\\": {\\n      \\\"approveRequest\\\": true,\\n      \\\"approveResponse\\\": false,\\n    },\\n  },\\n  \\\"aws.cloudformation.telemetry.enabled\\\": true,\\n  \\\"cursorcode.prompt\\\": \\\"Ola, pode ficar em pt-br\\\",\\n  \\\"amazonQ.suppressPrompts\\\": {\\n    \\\"amazonQChatDisclaimer\\\": true,\\n    \\\"amazonQChatPairProgramming\\\": true,\\n  },\\n  \\\"chat.editing.confirmEditRequestRemoval\\\": false,\\n  \\\"terminal.integrated.commandsToSkipShell\\\": [\\n    \\\"kilo-code.new.agentManagerOpen\\\",\\n    \\\"kilo-code.new.agentManager.showTerminal\\\",\\n    \\\"kilo-code.new.agentManager.previousTerminal\\\",\\n    \\\"kilo-code.new.agentManager.nextTerminal\\\",\\n  ],\\n  \\\"kilo-code.new.agentWorkStyle\\\": \\\"skipped\\\",\\n  \\\"kilo-code.new.autocomplete.provider\\\": \\\"kilo\\\",\\n  \\\"kilo-code.new.autocomplete.model\\\": \\\"mistralai/codestral-2508\\\",\\n  \\\"kilo-code.new.autoApprove.enabled\\\": true,\\n  \\\"kilo-code.new.showTaskTimeline\\\": false,\\n  \\\"terminal.integrated.initialHint\\\": false,\\n  \\\"explorer.confirmDelete\\\": false,\\n  \\\"github.copilot.nextEditSuggestions.enabled\\\": true,\\n  \\\"workbench.startupEditor\\\": \\\"none\\\",\\n  \\\"chat.agent.maxRequests\\\": 1000,\\n  \\\"chat.byokUtilityModelDefault\\\": \\\"mainAgent\\\",\\n  \\\"editor.accessibilitySupport\\\": \\\"off\\\",\\n  \\\"github.copilot.chat.codesearch.enabled\\\": true,\\n  \\\"github.copilot.chat.alternateGptPrompt.enabled\\\": true,\\n  \\\"chat.editing.autoAcceptDelay\\\": 30,\\n  \\\"editor.formatOnSave\\\": true,\\n  \\\"editor.defaultFormatter\\\": \\\"esbenp.prettier-vscode\\\",\\n  \\\"editor.codeActionsOnSave\\\": {\\n    \\\"source.fixAll.eslint\\\": \\\"explicit\\\",\\n  },\\n  \\\"prettier.singleQuote\\\": true,\\n  \\\"prettier.trailingComma\\\": \\\"es5\\\",\\n  \\\"files.trimTrailingWhitespace\\\": true,\\n  \\\"chatgpt.followUpQueueMode\\\": \\\"queue\\\",\\n  \\\"@azure.argTenant\\\": \\\"\\\",\\n  \\\"chat.hookFilesLocations\\\": {\\n    \\\".github/hooks\\\": true,\\n    \\\".claude/settings.local.json\\\": true,\\n    \\\".claude/settings.json\\\": true,\\n    \\\"~/.copilot/hooks\\\": true,\\n    \\\"~/.claude/settings.json\\\": true,\\n    \\\"~/.agents/hooks\\\": true,\\n  },\\n  \\\"chat.useClaudeHooks\\\": true,\\n  \\\"chat.viewSessions.orientation\\\": \\\"stacked\\\",\\n  \\\"opencodex.maxSteps\\\": 0,\\n  \\\"opencodex.provider\\\": \\\"opencode\\\",\\n  \\\"opencodex.extraFreeModels\\\": \\\"\\\",\\n  \\\"opencodex.model\\\": \\\"muse-spark-1.2-contributor-free\\\",\\n}\\n\"}","keybindings":"{\"keybindings\":\"// Coloque as suas associações de teclas neste arquivo para substituir os padrõesauto[]\\r\\n[\\r\\n  {\\r\\n    \\\"key\\\": \\\"ctrl+oem_6\\\",\\r\\n    \\\"command\\\": \\\"editor.action.indentLines\\\",\\r\\n    \\\"when\\\": \\\"editorTextFocus && !editorReadonly\\\"\\r\\n  },\\r\\n  {\\r\\n    \\\"key\\\": \\\"ctrl+oem_6\\\",\\r\\n    \\\"command\\\": \\\"-editor.action.indentLines\\\",\\r\\n    \\\"when\\\": \\\"editorTextFocus && !editorReadonly\\\"\\r\\n  },\\r\\n  {\\r\\n    \\\"key\\\": \\\"ctrl+oem_6\\\",\\r\\n    \\\"command\\\": \\\"-extension.refactorix.ArrowFunction.ToggleSingleStatementBlockExpression\\\",\\r\\n    \\\"when\\\": \\\"editorTextFocus\\\"\\r\\n  },\\r\\n  {\\r\\n    \\\"key\\\": \\\"ctrl+oem_5\\\",\\r\\n    \\\"command\\\": \\\"-workbench.action.splitEditor\\\"\\r\\n  },\\r\\n  {\\r\\n    \\\"key\\\": \\\"ctrl+oem_5\\\",\\r\\n    \\\"command\\\": \\\"editor.action.outdentLines\\\",\\r\\n    \\\"when\\\": \\\"editorTextFocus && !editorReadonly\\\"\\r\\n  },\\r\\n  {\\r\\n    \\\"key\\\": \\\"ctrl+oem_4\\\",\\r\\n    \\\"command\\\": \\\"-editor.action.outdentLines\\\",\\r\\n    \\\"when\\\": \\\"editorTextFocus && !editorReadonly\\\"\\r\\n  }\\r\\n]\",\"platform\":3}","snippets":"{\"snippets\":{\"html.json\":\"{\\n\\t// Place your snippets for html here. Each snippet is defined under a snippet name and has a prefix, body and \\n\\t// description. The prefix is what is used to trigger the snippet and the body will be expanded and inserted. Possible variables are:\\n\\t// $1, $2 for tab stops, $0 for the final cursor position, and ${1:label}, ${2:another} for placeholders. Placeholders with the \\n\\t// same ids are connected.\\n\\t// Example:\\n\\t// \\\"Print to console\\\": {\\n\\t// \\t\\\"prefix\\\": \\\"log\\\",\\n\\t// \\t\\\"body\\\": [\\n\\t// \\t\\t\\\"console.log('$1');\\\",\\n\\t// \\t\\t\\\"$2\\\"\\n\\t// \\t],\\n\\t// \\t\\\"description\\\": \\\"Log output to console\\\"\\n\\t// }\\n\\t\\\"HTML Skeleton for React App with CDN\\\": {\\n\\t\\t\\\"prefix\\\": \\\"!rt\\\",\\n\\t\\t\\\"body\\\": [    \\\"<!DOCTYPE html>\\\",    \\\"<html lang=\\\\\\\"pt\\\\\\\">\\\",    \\\"<head>\\\",    \\\"  <meta charset=\\\\\\\"UTF-8\\\\\\\">\\\",    \\\"  <meta http-equiv=\\\\\\\"X-UA-Compatible\\\\\\\" content=\\\\\\\"IE=edge\\\\\\\">\\\",    \\\"  <meta name=\\\\\\\"viewport\\\\\\\" content=\\\\\\\"width=device-width, initial-scale=1.0\\\\\\\">\\\",    \\\"  <title>${1:React App Na Trybe}</title>\\\",    \\\"  <meta name=\\\\\\\"description\\\\\\\" content=\\\\\\\"Um app de React feito no curso da Trybe :3\\\\\\\">\\\",    \\\"</head>\\\",    \\\"<body>\\\",    \\\"  <div id=\\\\\\\"root\\\\\\\"></div>\\\",    \\\"  <script crossorigin src=\\\\\\\"https://unpkg.com/react@17/umd/react.development.js\\\\\\\"></script>\\\",    \\\"  <script crossorigin src=\\\\\\\"https://unpkg.com/react-dom@17/umd/react-dom.development.js\\\\\\\"></script>\\\",    \\\"  <script src=\\\\\\\"https://unpkg.com/babel-standalone@6/babel.min.js\\\\\\\"></script>\\\", \\\"  <script src=\\\\\\\"${2:main.jsx}\\\\\\\" type=\\\\\\\"text/babel\\\\\\\"></script>\\\",    \\\"</body>\\\",    \\\"</html>\\\"],\\n\\t\\t\\\"description\\\": \\\"Cria um esqueleto de um app React para a Trybe\\\"\\n\\t},\\n\\t\\\"HTML Skeleton for React App with CDN including Prop Types\\\": {\\n\\t\\t\\\"prefix\\\": \\\"!rtp\\\",\\n\\t\\t\\\"body\\\": [    \\\"<!DOCTYPE html>\\\",    \\\"<html lang=\\\\\\\"pt\\\\\\\">\\\",    \\\"<head>\\\",    \\\"  <meta charset=\\\\\\\"UTF-8\\\\\\\">\\\",    \\\"  <meta http-equiv=\\\\\\\"X-UA-Compatible\\\\\\\" content=\\\\\\\"IE=edge\\\\\\\">\\\",    \\\"  <meta name=\\\\\\\"viewport\\\\\\\" content=\\\\\\\"width=device-width, initial-scale=1.0\\\\\\\">\\\",    \\\"  <title>${1:React App Na Trybe}</title>\\\",    \\\"  <meta name=\\\\\\\"description\\\\\\\" content=\\\\\\\"Um app de React feito no curso da Trybe :3\\\\\\\">\\\",    \\\"</head>\\\",    \\\"<body>\\\",    \\\"  <div id=\\\\\\\"root\\\\\\\"></div>\\\",    \\\"  <script crossorigin src=\\\\\\\"https://unpkg.com/react@17/umd/react.development.js\\\\\\\"></script>\\\",    \\\"  <script crossorigin src=\\\\\\\"https://unpkg.com/react-dom@17/umd/react-dom.development.js\\\\\\\"></script>\\\",    \\\"  <script src=\\\\\\\"https://unpkg.com/babel-standalone@6/babel.min.js\\\\\\\"></script>\\\", \\\"  <script src=\\\\\\\"https://cdnjs.cloudflare.com/ajax/libs/prop-types/15.7.2/prop-types.min.js\\\\\\\" integrity=\\\\\\\"sha512-ssNhh7jlzc+K93ckIlSXFHHz6fSFv0l619WOv8xbFNRbFOujbasb42LVMOggDrQR1ScJncoWb+KAJx1uF3ipjw==\\\\\\\" crossorigin=\\\\\\\"anonymous\\\\\\\" referrerpolicy=\\\\\\\"no-referrer\\\\\\\"></script>\\\",    \\\"  <script src=\\\\\\\"${2:main.jsx}\\\\\\\" type=\\\\\\\"text/babel\\\\\\\"></script>\\\",    \\\"</body>\\\",    \\\"</html>\\\"],\\n\\t\\t\\\"description\\\": \\\"Cria um esqueleto de um app React para a Trybe\\\"\\n\\t},\\n\\n}\",\"javascriptreact.json\":\"{\\n\\t// Place your snippets for javascriptreact here. Each snippet is defined under a snippet name and has a prefix, body and \\n\\t// description. The prefix is what is used to trigger the snippet and the body will be expanded and inserted. Possible variables are:\\n\\t// $1, $2 for tab stops, $0 for the final cursor position, and ${1:label}, ${2:another} for placeholders. Placeholders with the \\n\\t// same ids are connected.\\n\\t// Example:\\n\\t// \\\"Print to console\\\": {\\n\\t// \\t\\\"prefix\\\": \\\"log\\\",\\n\\t// \\t\\\"body\\\": [\\n\\t// \\t\\t\\\"console.log('$1');\\\",\\n\\t// \\t\\t\\\"$2\\\"\\n\\t// \\t],\\n\\t// \\t\\\"description\\\": \\\"Log output to console\\\"\\n\\t// }\\n\\t\\\"Base React skeleton\\\": {\\n\\t\\t\\\"prefix\\\": \\\"!jsx\\\",\\n\\t\\t\\\"body\\\": [    \\\"class App extends React.Component {\\\",    \\\"  constructor(props) {\\\",    \\\"    super(props);\\\",    \\\"  }\\\",    \\\"\\\",    \\\"  render() {\\\",    \\\"    return <div>{this.props.children}</div>\\\",    \\\"  }\\\",    \\\"}\\\", \\\"\\\", \\\"${0}\\\", \\\"\\\", \\\"ReactDOM.render(\\\",    \\\"  <App>\\\", \\\"    \\\", \\\"  </App>,\\\" , \\\"  document.getElementById('root'),\\\",    \\\");\\\"],\\n\\t\\t\\\"description\\\": \\\"Cria o esqueleto de um App react que utiliza CDN\\\"\\n\\t}\\n}\"}}","extensions":"[{\"identifier\":{\"id\":\"adpyke.codesnap\",\"uuid\":\"8c1fc960-44b1-45e8-89b5-85f982fdaf27\"},\"displayName\":\"CodeSnap\",\"applicationScoped\":false},{\"identifier\":{\"id\":\"adrianwilczynski.libman\",\"uuid\":\"20cc31be-46f0-4bbd-8633-c49bef933020\"},\"displayName\":\"LibMan Tools\",\"applicationScoped\":false},{\"identifier\":{\"id\":\"adrianwilczynski.terminal-commands\",\"uuid\":\"ccdb378e-214a-468c-bfce-12192011281c\"},\"displayName\":\"Run Terminal Command\",\"applicationScoped\":false},{\"identifier\":{\"id\":\"adrianwilczynski.toggle-hidden\",\"uuid\":\"750e3144-fb21-4637-96a8-40fcc8402dad\"},\"displayName\":\"Peek Hidden Files\",\"applicationScoped\":false},{\"identifier\":{\"id\":\"ahmadawais.shades-of-purple\",\"uuid\":\"431aa1a8-74f4-43d5-a83b-f4960510da5f\"},\"displayName\":\"Shades of Purple\",\"applicationScoped\":false},{\"identifier\":{\"id\":\"alefragnani.bookmarks\",\"uuid\":\"b689fcc8-d494-4dbf-a228-2c694a578afc\"},\"displayName\":\"Bookmarks\",\"applicationScoped\":false},{\"identifier\":{\"id\":\"amazonwebservices.aws-toolkit-vscode\",\"uuid\":\"ac5787df