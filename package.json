{
  "name": "sabor-de-abraço-pdv",
  "version": "1.0.0",
  "private": true,
  "description": "Sabor de Abraço - Sistema de PDV (MERN)",
  "scripts": {
    "dev:backend": "cd back-end && nodemon server.js",
    "dev:frontend": "cd front-end && vite",
    "start": "node back-end/server.js",
    "test": "cd back-end && cross-env NODE_ENV=test jest --verbose --runInBand",
    "test:watch": "cd back-end && cross-env NODE_ENV=test jest --watch",
    "test:coverage": "cd back-end && cross-env NODE_ENV=test jest --coverage --runInBand",
    "test:frontend": "cd front-end && cypress run",
    "test:frontend:open": "cd front-end && cypress open",
    "test:all": "npm run test && npm run test:frontend",
    "lint": "cd front-end && npx eslint src"
  },
  "devDependencies": {}
}
}
